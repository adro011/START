# Supabase (public, safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — SERVER ONLY, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL used for metadata, OG images, and redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number override (full international form, e.g. "+8801XXXXXXXXX")
NEXT_PUBLIC_WHATSAPP=

# Email — transactional notifications (contact form, registrations, orders) via Resend
RESEND_API_KEY=
# Where new contact-form messages are emailed (defaults to the site email)
CONTACT_NOTIFY_EMAIL=
# Where new "Join us" registrations are emailed (defaults to the site email)
REGISTRATION_NOTIFY_EMAIL=
# Verified Resend sender (defaults to "ABRAR <onboarding@resend.dev>")
RESEND_FROM_EMAIL=

# SSLCommerz sandbox credentials (dev only — use sandbox endpoint until live approval)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASS=
SSLCOMMERZ_ENDPOINT=https://sandbox.sslcommerz.com
# Feature flag: keep false until sandbox IPN flow is verified
PAYMENT_SSLCOMMERZ_ENABLED=false

# Rate-limit / cache (optional) — Upstash Redis; in-memory fallback in dev
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Demo-cookie login (unsigned convenience login for local dev).
# NEVER enable in production — the demo cookie is unsigned JSON and must
# not be a privilege source on a live store. Default: enabled everywhere
# except production.
ALLOW_DEMO_LOGIN=false

# Signs the shop-registry session cookie (HMAC-SHA256, httpOnly).
# REQUIRED for registry staff sign-in — without it nobody can log in.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it invalidates every existing registry session.
REGISTRY_SESSION_SECRET=

# Cloudflare Turnstile bot protection on checkout, signup, contact
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# GitHub Content Sync (optional) — exports site_sections + theme_tokens to repo
# Generate token: GitHub Settings → Developer settings → Personal access tokens (classic)
# Scope: repo (full control) or public_repo for public repos
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main
GITHUB_CONTENT_PATH=content
